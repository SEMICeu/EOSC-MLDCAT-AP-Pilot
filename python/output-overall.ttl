<https://api.cloud.ai4eosc.eu/v1/catalog/modules/birds-audio-classification/metadata> a it6:MachineLearningModel ;
    it6:fineTunedFrom <https://github.com/ai4os-hub/ai4os-audio-classification-tf> ;
