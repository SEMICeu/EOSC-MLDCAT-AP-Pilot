<https://api.cloud.ai4eosc.eu/v1/catalog/modules/smartbay-species-detection/metadata> a it6:MachineLearningModel ;
    it6:hasMachineLearningLibrary <http://w3id.org/ai4os/vocabulary/library/PyTorch> ;
