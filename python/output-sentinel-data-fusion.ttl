    dct:title "Sentinel-2 and Sentinel-3 data fusion with CNN and GAN"@en ;
    dct:type <http://w3id.org/ai4os/vocabulary/category/AI4_inference>,
        <http://w3id.org/ai4os/vocabulary/category/AI4_pre_trained> ;
    dcat:keyword "data fusion"@en,
        "deep learning"@en,
        "remote sensing"@en .

