    dct:modified "2025-05-07"^^xsd:date ;
    dct:title "Thermal Anomaly Segmenter (TASeg)"@en ;
    dct:type <http://w3id.org/ai4os/vocabulary/category/AI4_inference>,
        <http://w3id.org/ai4os/vocabulary/category/AI4_pre_trained>,
        <http://w3id.org/ai4os/vocabulary/category/AI4_trainable> ;
    dcat:keyword "DeepLabV3+"@en,
        "SegFormer"@en,
        "deep learning"@en,
        "remote sensing"@en,
        "semantic segmentation"@en,
        "thermal imagery"@en,
        "transformers"@en .

