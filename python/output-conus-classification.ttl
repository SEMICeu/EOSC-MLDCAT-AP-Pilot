    dct:title "Conus species classifier"@en ;
    dct:type <http://w3id.org/ai4os/vocabulary/category/AI4_inference>,
        <http://w3id.org/ai4os/vocabulary/category/AI4_pre_trained> ;
    dcat:keyword "deep learning"@en,
        "image classification"@en,
        "vo.imagine-ai.eu"@en .

